#include <TinyGPS++.h>
#include <SoftwareSerial.h>
 
#include "SSD1306.h"


String response="";
SSD1306  display(0x3c, 4, 5); //define Instance for  OLED1306 Library

// The TinyGPS++ object
TinyGPSPlus gps;

// The serial connection to the GPS device nodeMCU(RX,TX)
SoftwareSerial GPS_Serial(13,15);
SoftwareSerial GSM_Serial(14,12);


void setup() {
   display.init();
   display.flipScreenVertically();
    display.setFont(ArialMT_Plain_10);
  display.setTextAlignment(TEXT_ALIGN_LEFT);
pinMode(16,OUTPUT);
digitalWrite(16,1);
Serial.begin(115200);
GSM_Serial.begin(115200);
GPS_Serial.begin(9600);
delay(1000);

RUN_GPSHW();

}

void loop() {

  smartDelay(1000);

  if (millis() > 5000 && gps.charsProcessed() < 10){
  display.clear();
  display.drawString(0, 33, "Nochars received");
    Serial.println(F("No GPS data received: check wiring"));
    display.display();
  }else{
display.clear();
String latitude =String (gps.location.lat(),6);
String Longitude=String (gps.location.lng(),6);
String HOUR=String(gps.time.hour());
String MINUTE=String(gps.time.minute());
String SECOND=String(gps.time.second());
String YEAR=String(gps.date.year());
String MONTH=String(gps.date.month());
String DAY=String(gps.date.day());
String SATELITES =String(gps.satellites.value());
String ALTITUDE =String(gps.altitude.meters());

  display.drawString(0, 0, "Latitude: "+latitude);
  display.drawString(0, 10, "Longitude: "+Longitude);
  display.drawString(0, 21, "Date : "+MONTH+"/"+DAY+"/"+YEAR);
  display.drawString(0, 32, "Time UTC : "+HOUR+":"+MINUTE+":"+SECOND);
  display.drawString(0, 43, "NO. of Satelites : "+SATELITES);
  display.drawString(0, 54, "Altitude Meters : "+ALTITUDE);
  display.display();
  }

  

}



void RUN_GPSHW(){
 /////////////////////////////////// to reset A7 if its ON
send_command("AT",response);
 delay(500);
send_command("AT",response);
 delay(500);
  send_command("AT+RST=1",response);
  /////////////////////////////////////////to power up A7
  digitalWrite(16,0);
  delay(3000);
  digitalWrite(16,1);
  /////////////////////////////////////////
   Serial.println("");
  display.clear();
  display.drawString(0, 0, "Waiting for A7 Module..");
    Serial.println(F("Waiting for A7 Module to Start.."));
    display.display();
  delay(20000);
 GSM_Serial.flush(); ////Clear Serial Buffer
send_command("AT",response);
 delay(500);
send_command("AT",response);
 delay(500);
 /////////////////////////////////set auto Baudrate of A7
 do{
   send_command("AT",response);
delay(300);
Serial.println(" reponse :"+response);
 }while(!response.startsWith("OK"));

Serial.println("GSM is "+response);
delay(2000);

////////////////////////////////////////////////
Serial.println(F("Attach to the network"));
send_command("AT+CGATT=1",response);
delay(5000);
Serial.println(F("activate the PDP context "));
send_command("AT+CGATT=1,1",response);
delay(5000);
send_command("AT+AGPS=1",response);
}
///////////////////////////////////////////////////////////////////////
// This custom version of delay() ensures that the gps object
// is being "fed".
static void smartDelay(unsigned long ms)
{
  unsigned long start = millis();
  do 
  {
    while (GPS_Serial.available())
      gps.encode(GPS_Serial.read());
  } while (millis() - start < ms);
}

/////////////////////////////////////////////////////////
void send_command(String command,String& Response){
     display.clear();
  display.drawString(0, 11, command+" >> ");
   display.display();
  Serial.print(command+" >> ");
  GSM_Serial.println(command);
  while(GSM_Serial.available()){
 Response=GSM_Serial.readStringUntil('\n');
}
  display.drawString(0, 23, Response);
   display.display();
Serial.println(Response);

 GSM_Serial.flush();
 delay(1000);
}

