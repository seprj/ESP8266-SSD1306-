#include <ESP8266WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <DHT.h>
#include <Wire.h>
#include "SSD1306.h"

//================== DHT ==================
#define DHTPIN D2
#define DHTTYPE DHT22

//================== PIR ==================
#define MOTION_PIN D5

//================== WiFi ==================
const char* ssid = "YOUR_WIFI";
const char* password = "YOUR_PASSWORD";

//================== HiveMQ ==================
const char* mqtt_server = "YOUR_BROKER.s1.eu.hivemq.cloud";
const int mqtt_port = 8883;

const char* mqtt_user = "Temp&Hum";
const char* mqtt_pass = "YOUR_PASSWORD";

//================== Objects ==================
WiFiClientSecure espClient;
PubSubClient client(espClient);

DHT dht(DHTPIN, DHTTYPE);
SSD1306 display(0x3c, D2, D1);

unsigned long lastMsg = 0;

//======================================================
// reconnect to broker
//======================================================
void reconnect()
{
  while (!client.connected())
  {
    String clientId = "ESP8266-";
    clientId += String(ESP.getChipId());

    Serial.print("Connecting...");

    if (client.connect(clientId.c_str(), mqtt_user, mqtt_pass))
    {
      Serial.println(" Connected");
    }
    else
    {
      Serial.print("Failed : ");
      Serial.println(client.state());
      delay(3000);
    }
  }
}

//======================================================

void setup()
{
  Serial.begin(115200);

  dht.begin();

  display.init();
  display.flipScreenVertically();

  WiFi.begin(ssid, password);

  Serial.print("Connecting WiFi");

  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi Connected");
  Serial.println(WiFi.localIP());

  // فقط برای تست
  espClient.setInsecure();

  client.setServer(mqtt_server, mqtt_port);
}

//======================================================

void loop()
{
  if (!client.connected())
    reconnect();

  client.loop();

  if (millis() - lastMsg > 2000)
  {
    lastMsg = millis();

    float t = dht.readTemperature();
    float h = dht.readHumidity();
    int motion = digitalRead(MOTION_PIN);

    if (!isnan(t))
      client.publish("sensor/temperature", String(t).c_str());

    if (!isnan(h))
      client.publish("sensor/humidity", String(h).c_str());

    client.publish("sensor/motion", String(motion).c_str());

    display.clear();

    display.drawString(0, 0, "Temp : " + String(t));
    display.drawString(0, 18, "Hum  : " + String(h));
    display.drawString(0, 36, "Move : " + String(motion));

    display.display();

    Serial.print("Temp : ");
    Serial.println(t);

    Serial.print("Hum  : ");
    Serial.println(h);

    Serial.print("Move : ");
    Serial.println(motion);
  }
}
