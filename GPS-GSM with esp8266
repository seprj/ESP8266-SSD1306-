#include <TinyGPS++.h>          // کتابخانه TinyGPS++ برای پردازش اطلاعات GPS
#include <SoftwareSerial.h>     // برای ساخت پورت سریال نرم‌افزاری

#include "SSD1306.h"             // کتابخانه کنترل نمایشگر OLED


// یک String برای نگهداری پاسخ ماژول GSM
String response = "";


// ساخت یک نمونه از نمایشگر OLED
// 0x3c = آدرس I2C نمایشگر
// 4 = پایه SDA
// 5 = پایه SCL
SSD1306 display(0x3c, 4, 5);


// ساخت یک شیء از کتابخانه TinyGPS++
// این شیء اطلاعات GPS را دریافت و تفسیر می‌کند
TinyGPSPlus gps;


// --------------------------------------------------
// ساخت پورت سریال نرم‌افزاری برای GPS
// --------------------------------------------------

// عدد 13 = RX
// عدد 15 = TX
//
// یعنی ESP8266 اطلاعات GPS را از این SoftwareSerial می‌خواند
SoftwareSerial GPS_Serial(13, 15);


// --------------------------------------------------
// ساخت پورت سریال نرم‌افزاری برای GSM
// --------------------------------------------------

// عدد 14 = RX
// عدد 12 = TX
//
// این پورت برای ارتباط با ماژول GSM استفاده می‌شود
SoftwareSerial GSM_Serial(14, 12);


void setup() {

  // راه‌اندازی OLED
  display.init();


  // برعکس کردن جهت تصویر OLED
  display.flipScreenVertically();


  // انتخاب فونت اندازه 10
  display.setFont(ArialMT_Plain_10);


  // قرار دادن متن از سمت چپ
  display.setTextAlignment(TEXT_ALIGN_LEFT);


  // GPIO16 را خروجی تعریف می‌کنیم
  pinMode(16, OUTPUT);


  // ابتدا GPIO16 را HIGH می‌کنیم
  digitalWrite(16, 1);


  // راه‌اندازی Serial اصلی
  // برای Debug کردن برنامه در Serial Monitor
  Serial.begin(115200);


  // راه‌اندازی ارتباط سریال با GSM
  GSM_Serial.begin(115200);


  // راه‌اندازی ارتباط سریال با GPS
  // GPS معمولاً با Baud Rate برابر 9600 کار می‌کند
  GPS_Serial.begin(9600);


  // یک ثانیه صبر
  delay(1000);


  // اجرای تابع راه‌اندازی سخت‌افزار GPS/GSM
  RUN_GPSHW();
}


void loop() {

  // به مدت یک ثانیه اطلاعات GPS را دریافت و پردازش می‌کنیم
  smartDelay(1000);


  // --------------------------------------------------
  // بررسی می‌کنیم آیا اطلاعات GPS دریافت شده یا نه
  // --------------------------------------------------

  if (millis() > 5000 && gps.charsProcessed() < 10) {

    // پاک کردن صفحه OLED
    display.clear();


    // نمایش پیام روی OLED
    display.drawString(
      0,
      33,
      "Nochars received"
    );


    // چاپ پیام خطا در Serial Monitor
    Serial.println(
      F("No GPS data received: check wiring")
    );


    // نمایش اطلاعات روی OLED
    display.display();

  }
  else {

    // اگر اطلاعات GPS دریافت شده باشد
    // صفحه OLED را پاک می‌کنیم
    display.clear();


    // ------------------------------------------------
    // دریافت Latitude
    // ------------------------------------------------

    // gps.location.lat()
    // عرض جغرافیایی را برمی‌گرداند
    //
    // عدد 6 یعنی 6 رقم اعشار نگه داشته شود

    String latitude =
      String(gps.location.lat(), 6);


    // ------------------------------------------------
    // دریافت Longitude
    // ------------------------------------------------

    String Longitude =
      String(gps.location.lng(), 6);


    // ------------------------------------------------
    // دریافت ساعت
    // ------------------------------------------------

    String HOUR =
      String(gps.time.hour());


    // ------------------------------------------------
    // دریافت دقیقه
    // ------------------------------------------------

    String MINUTE =
      String(gps.time.minute());


    // ------------------------------------------------
    // دریافت ثانیه
    // ------------------------------------------------

    String SECOND =
      String(gps.time.second());


    // ------------------------------------------------
    // دریافت سال
    // ------------------------------------------------

    String YEAR =
      String(gps.date.year());


    // ------------------------------------------------
    // دریافت ماه
    // ------------------------------------------------

    String MONTH =
      String(gps.date.month());


    // ------------------------------------------------
    // دریافت روز
    // ------------------------------------------------

    String DAY =
      String(gps.date.day());


    // ------------------------------------------------
    // تعداد ماهواره‌های GPS
    // ------------------------------------------------

    String SATELITES =
      String(gps.satellites.value());


    // ------------------------------------------------
    // ارتفاع از سطح دریا
    // ------------------------------------------------

    String ALTITUDE =
      String(gps.altitude.meters());


    // --------------------------------------------------
    // نمایش Latitude روی OLED
    // --------------------------------------------------

    display.drawString(
      0,
      0,
      "Latitude: " + latitude
    );


    // نمایش Longitude
    display.drawString(
      0,
      10,
      "Longitude: " + Longitude
    );


    // نمایش تاریخ
    display.drawString(
      0,
      21,
      "Date : " +
      MONTH + "/" +
      DAY + "/" +
      YEAR
    );


    // نمایش ساعت UTC
    display.drawString(
      0,
      32,
      "Time UTC : " +
      HOUR + ":" +
      MINUTE + ":" +
      SECOND
    );


    // نمایش تعداد ماهواره‌ها
    display.drawString(
      0,
      43,
      "NO. of Satelites : " +
      SATELITES
    );


    // نمایش ارتفاع
    display.drawString(
      0,
      54,
      "Altitude Meters : " +
      ALTITUDE
    );


    // ارسال تمام اطلاعاتی که آماده کردیم
    // به صفحه OLED
    display.display();
  }
}
