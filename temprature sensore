#include <Wire.h>          // کتابخانه ارتباط I2C برای OLED
#include "SSD1306.h"       // کتابخانه نمایشگر OLED SSD1306
#include "DHT.h"           // کتابخانه سنسور DHT22

//-------------------- تنظیمات سنسور DHT22 --------------------

// پایه‌ای که پایه DATA سنسور DHT22 به آن متصل است
#define DHTPIN D3

// نوع سنسور (DHT22)
#define DHTTYPE DHT22

// ساخت یک شیء از کلاس DHT
DHT dht(DHTPIN, DHTTYPE);

//-------------------- تنظیمات OLED --------------------

// آدرس I2C نمایشگر = 0x3C
// SDA = GPIO4 (D2)
// SCL = GPIO5 (D1)
SSD1306 display(0x3c, 4, 5);

//-------------------- متغیرهای عمومی --------------------

// متغیر ذخیره رطوبت
int localHum = 0;

// متغیر ذخیره دمای DHT22
int localTemp = 0;

//======================================================
// تابع Setup
// فقط یک بار هنگام روشن شدن اجرا می‌شود
//======================================================
void setup()
{
    // راه‌اندازی OLED
    display.init();

    // برعکس کردن جهت نمایش
    // (در بعضی ماژول‌ها لازم است)
    display.flipScreenVertically();

    // راه‌اندازی سنسور DHT22
    dht.begin();
}

//======================================================
// حلقه اصلی برنامه
//======================================================
void loop()
{
    // پاک کردن حافظه نمایشگر
    display.clear();

    // خواندن اطلاعات DHT22
    getDHT();

    // نمایش اطلاعات DHT22
    drawDHT();

    // خواندن و نمایش اطلاعات LM35
    drawLM35();

    // ارسال تمام اطلاعات بافر به OLED
    display.display();
}

//======================================================
// خواندن اطلاعات سنسور DHT22
//======================================================
void getDHT()
{
    // خواندن دمای محیط از DHT22
    localTemp = dht.readTemperature();

    // خواندن رطوبت محیط از DHT22
    localHum = dht.readHumidity();
}

/***************************************************
 * نمایش اطلاعات DHT22 روی OLED
 ***************************************************/
void drawDHT()
{
    // مختصات مبدا
    int x = 0;
    int y = 0;

    //---------------- عنوان ----------------

    display.setFont(ArialMT_Plain_10);            // انتخاب فونت 10
    display.setTextAlignment(TEXT_ALIGN_LEFT);    // تراز متن از سمت چپ

    // نوشتن عنوان DHT22
    display.drawString(43 + x, y, "DHT22");

    //---------------- رطوبت ----------------

    display.setFont(ArialMT_Plain_10);
    display.drawString(0 + x, 5 + y, "Hum");

    // انتخاب فونت بزرگ‌تر برای مقدار
    display.setFont(ArialMT_Plain_24);

    // تبدیل مقدار رطوبت به رشته
    String humdht22 = String(localHum);

    // نمایش مقدار رطوبت همراه با %
    display.drawString(0 + x, 15 + y, humdht22 + "%");

    //---------------- دما ----------------

    display.setFont(ArialMT_Plain_10);

    // نوشتن عنوان Temp
    display.drawString(95 + x, 5 + y, "Temp");

    // انتخاب فونت بزرگ
    display.setFont(ArialMT_Plain_24);

    // تبدیل دما به رشته
    String tempdht22 = String(localTemp);

    // نمایش دما همراه با درجه سانتی‌گراد
    display.drawString(70 + x, 15 + y, tempdht22 + "°C");
}

//======================================================
// خواندن سنسور LM35 و نمایش روی OLED
//======================================================
void drawLM35()
{
    int x = 0;
    int y = 0;

    // متغیر جمع نمونه‌های ADC
    int val = 0;

    // ده بار مقدار ADC خوانده می‌شود
    // تا میانگین گرفته شود و نویز کمتر شود
    for (int i = 0; i < 10; i++)
    {
        // خواندن پایه آنالوگ A0
        val += analogRead(A0);

        // کمی تأخیر بین نمونه‌ها
        delay(200);
    }

    /*
        خروجی ADC بین 0 تا 1023 است.

        LM35 به ازای هر 1 درجه،
        10mV تولید می‌کند.

        ولتاژ مرجع ESP8266 برابر 3.3V است.

        بنابراین:

        Temp = ADC × 3.3 ×100 /1023

        چون:
        3.3 ×100 =330

        و میانگین 10 نمونه گرفته‌ایم،
        تقسیم بر 10 حذف شده و فرمول ساده شده است:

        Temp = val ×33 /1023
    */

    int templm35 = val * 33 / 1023;

    // تبدیل دما به رشته
    String temprature(templm35);

    // نمایش عنوان
    display.setFont(ArialMT_Plain_10);
    display.setTextAlignment(TEXT_ALIGN_LEFT);
    display.drawString(34 + x, 37 + y, "LM35 Temp");

    // نمایش مقدار دما
    display.setFont(ArialMT_Plain_16);
    display.drawString(46, 48, temprature + "°C");
}
